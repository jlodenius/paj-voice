{
  "voice": {
    "version": 1,
    "languages": ["en"],
    "responseLanguage": "en",
    "python": "paj-voice-audio",
    "cacheDir": "/absolute/path/to/project/.cache/paj-voice",
    "stt": { "computeType": "int8" },
    "tts": {},
    "audio": {
      "input": "alsa_input.pci-0000_00_1f.3.analog-stereo",
