#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
mode="${1:-check}"
if (($#)); then shift; fi
case "$mode" in
  check) args=(--check) ;;
  run|agent) args=(--run --seconds 90
    --input "${PAJ_VOICE_LAB_INPUT:-alsa_input.pci-0000_00_1f.3.analog-stereo}"
    --output "${PAJ_VOICE_LAB_OUTPUT:-bluez_output.58_18_62_86_34_AC.1}")
    if [[ "$mode" == agent ]]; then args+=(--agent); fi
    ;;
  help|-h|--help)
    printf '%s\n' 'Continuous speech: local demo or explicit read-only Pi trial, no classifier:' \
      '  scripts/continuous-test check           Load speech models, no microphone' \
      '  scripts/continuous-test run --warmup-only  Readiness only; at most 6s capture' \
      '  scripts/continuous-test run --show-text  Explicit 90s local demo' \
      '  scripts/continuous-test agent --agent-socket PATH --session ID --show-text' \
      'Agent mode sends recognized text to the pinned Pi model; requires /voice-trial prepare.' \
      'Wait for the beep and READY. Speak naturally, then interrupt the fixed reply.' \
      'Ctrl-C stops capture. No real commands, gain changes, or recording files.'
    exit 0
    ;;
  *) printf 'Unknown mode; run scripts/continuous-test help\n' >&2; exit 2 ;;
esac
nix-build --no-build-output nix/continuous.nix -o result-continuous
exec ./result-continuous/bin/paj-voice-continuous-test "${args[@]}" "$@"
