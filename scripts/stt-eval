#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
mode="${1:-check}"
if (($#)); then shift; fi
case "$mode" in
  check) args=(--check) ;;
  run|levels) args=(--run --input "${PAJ_VOICE_LAB_INPUT:-alsa_input.pci-0000_00_1f.3.analog-stereo}"
    --output "${PAJ_VOICE_LAB_OUTPUT:-bluez_output.58_18_62_86_34_AC.1}")
    if [[ "$mode" == levels ]]; then args+=(--levels-only); fi
    ;;
  help|-h|--help)
    printf '%s\n' 'STT-only paired evaluation, no classifier or agent commands:' \
      '  scripts/stt-eval check          Load packaged Whisper/VAD, no microphone' \
      '  scripts/stt-eval run --quick    Five prompted microphone windows' \
      '  scripts/stt-eval run            Nine prompted microphone windows' \
      '  scripts/stt-eval levels         Two silent level traces; no Whisper' \
      'Each window requires Enter consent; raw audio stays in RAM and is discarded.' \
      'Transcripts appear in your terminal. Ctrl-C exits. No audio settings change.'
    exit 0
    ;;
  *) printf 'Unknown mode; run scripts/stt-eval help\n' >&2; exit 2 ;;
esac
nix-build --no-build-output nix/stt-eval.nix -o result-stt-eval
exec ./result-stt-eval/bin/paj-voice-stt-eval "${args[@]}" "$@"
