#!/usr/bin/env bash
set -euo pipefail
cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
mode="${1:-check}"
if (($#)); then shift; fi
args=()
case "$mode" in
  continuous) exec ./scripts/continuous-test run "$@" ;;
  agent) exec ./scripts/continuous-test agent "$@" ;;
  continuous-check) exec ./scripts/continuous-test check "$@" ;;
  check) args=(--check) ;;
  self-test) args=(--self-test) ;;
  text)
    if (($# == 0)); then printf 'Usage: %s text "test phrase"\n' "$0" >&2; exit 2; fi
    args=(--text "$1" --agent nix)
    shift
    ;;
  confirm|live)
    args=(--live --agent nix --seconds 90 --playback-demo
      --input "${PAJ_VOICE_LAB_INPUT:-alsa_input.pci-0000_00_1f.3.analog-stereo}"
      --output "${PAJ_VOICE_LAB_OUTPUT:-bluez_output.58_18_62_86_34_AC.1}")
    if [[ "$mode" == confirm ]]; then args+=(--force-confirm); fi
    ;;
  help|-h|--help)
    printf '%s\n' 'Commands-disabled paj-voice lab:' \
      '  scripts/voice-lab agent --agent-socket PATH --session ID --show-text' \
      '    Real read-only Pi trial; requires /voice-trial prepare in pinned session' \
      '  scripts/voice-lab continuous --warmup-only  Local readiness diagnostics, no STT/agent' \
      '  scripts/voice-lab continuous --show-text  No-classifier continuous trial' \
      '  scripts/voice-lab continuous-check       No-microphone speech preflight' \
      '  scripts/voice-lab check       Load models; no microphone' \
      '  scripts/voice-lab self-test   Synthetic speech test; no microphone' \
      '  scripts/voice-lab text "..."  Typed classifier/confirmation trial' \
      '  scripts/voice-lab confirm     90s microphone trial; force confirmation' \
      '  scripts/voice-lab live        90s microphone trial; real classification' \
      'Headphones required for microphone modes. Ctrl-C stops capture.' \
      'Agent mode sends text to Pi; local lab modes do not. No system audio changes or audio files.'
    exit 0
    ;;
  *) printf 'Unknown mode; run scripts/voice-lab help\n' >&2; exit 2 ;;
esac
classifier="${PAJ_VOICE_LAB_CLASSIFIER:-gliclass}"
case "$classifier" in
  gliner2|gliclass) ;;
  *) printf 'Unknown classifier variant: use gliner2 or gliclass\n' >&2; exit 2 ;;
esac
nix-build --no-build-output nix/lab.nix --argstr classifier "$classifier" -o result
exec ./result/bin/paj-voice-lab "${args[@]}" "$@"
