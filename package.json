{
  "name": "paj-voice",
  "version": "0.1.0",
  "private": true,
  "description": "Local, eyes-free voice conversations with an existing Pi session",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "keywords": ["pi-package", "voice"],
  "files": ["extensions", "dist", "src", "scripts/build.ts", "tsconfig.json", "audio/paj_voice_audio/*.py", "README.md", "LICENSE", "examples", "docs"],
  "scripts": {
    "build": "node scripts/build.ts",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json",
    "format": "prettier --no-config --write --no-error-on-unmatched-pattern \"**/*.ts\"",
    "format:check": "prettier --no-config --check --no-error-on-unmatched-pattern \"**/*.ts\"",
    "test": "node --test tests/*.test.js && PYTHONPATH=\"$PWD/audio\" python3 -m unittest discover -s audio/tests -v"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.5.2",
    "@earendil-works/pi-tui": "^1.5.2",
    "@types/node": "^24.0.0",
    "prettier": "3.10.1",
    "typebox": "^1.4.7",
    "typescript": "^5.9.3"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": "*", "@earendil-works/pi-tui": "*", "typebox": "*" },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  },
  "pi": { "extensions": ["extensions/index.ts"] }
}
