{
  "name": "paj-voice",
  "version": "0.1.0",
  "description": "Local, eyes-free voice conversations with an existing Pi session",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24" },
  "keywords": ["pi-package", "voice"],
  "files": ["extensions", "src", "audio", "pyproject.toml", "README.md", "LICENSE", "examples"],
  "scripts": {
    "test": "node --test tests/*.test.js && PYTHONPATH=\"$PWD/audio\" python3 -m unittest discover -s audio/tests -v"
  },
  "peerDependencies": { "@earendil-works/pi-coding-agent": ">=1.5.2", "typebox": "*" },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "typebox": { "optional": true }
  },
  "pi": { "extensions": ["extensions/index.ts"] }
}
